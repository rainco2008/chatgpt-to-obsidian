{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": "build",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "removeComments": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
